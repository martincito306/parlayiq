# ==============================================================================
# PARLAYIQ — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="PARLAYIQ"
VERSION="1.0.0"

# Security
SECRET_KEY=parlayiq-super-secret-key-change-in-production-2026-quant-engine
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: Async SQLite zero-friction | Production: PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./parlayiq.db
# DATABASE_URL=postgresql+asyncpg://parlayiq_user:parlayiq_pass@localhost:5432/parlayiq_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# SPORTS DATA PROVIDERS (Optional / Interchangeable)
# If left blank, PARLAYIQ runs automatically on verified open datasets
# (football-data.co.uk) and calibrated precision engine.
# ------------------------------------------------------------------------------

# API-Football (RapidAPI / api-sports.io - Free tier 100 req/day)
API_FOOTBALL_KEY=

# football-data.org (Free tier 10 req/min for top European leagues)
FOOTBALL_DATA_ORG_KEY=

# The Odds API (Real Bookmaker Lines from Pinnacle, Bet365 - Free tier 500 req/mo)
THE_ODDS_API_KEY=

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
